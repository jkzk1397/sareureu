<?xml version="1.0" encoding="utf-8"?>
<!--
  정밀 모드(ADR-0004 보완). 추적 앱 7개의 창 전환·넘김·누름만 받는다.
  canPerformGestures, 키 이벤트 필터는 켜지 않는다(다른 앱을 조작하지 않음, AGENTS 3절 규칙 4).
  장애인 지원 도구가 아니므로 isAccessibilityTool=false(앱 안 고지와 동의 필수).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewScrolled|typeViewClicked"
  android:accessibilityFeedbackType="feedbackGeneric"
  android:accessibilityFlags="flagReportViewIds"
  android:canRetrieveWindowContent="true"
  android:description="@string/sensing_accessibility_description"
  android:isAccessibilityTool="false"
  android:notificationTimeout="200"
  android:packageNames="com.google.android.youtube,com.instagram.android,com.instagram.lite,com.ss.android.ugc.trill,com.zhiliaoapp.musically,com.zhiliaoapp.musically.go,com.ss.android.ugc.tiktok.lite"
  tools:ignore="UnusedAttribute" />
