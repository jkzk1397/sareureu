[
  {
    "name": "a01",
    "text": "야 이 한심한 놈아 그만 봐"
  },
  {
    "name": "a02",
    "text": "넌 진짜 쇼츠 중독자야"
  },
  {
    "name": "a03",
    "text": "병신아 폰 내려놔"
  },
  {
    "name": "a04",
    "text": "씨발 언제까지 볼래"
  },
  {
    "name": "a05",
    "text": "정신 차려 루저야"
  },
  {
    "name": "a06",
    "text": "뚱뚱해지기 전에 운동이나 해"
  },
  {
    "name": "a07",
    "text": "의지가 약해서 그래"
  },
  {
    "name": "a08",
    "text": "쓰레기 같은 영상 그만 봐"
  },
  {
    "name": "a09",
    "text": "닥쳐 그리고 자"
  },
  {
    "name": "a10",
    "text": "니 엄마가 알면 울겠다"
  }
]
