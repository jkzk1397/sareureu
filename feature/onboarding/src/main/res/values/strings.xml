  <!-- 4. 추적 앱 -->
  <string name="onboarding_apps_title">어떤 앱을 볼까?</string>
  <string name="onboarding_apps_body">이 앱들을 열고 닫은 시각만 세. 앱 안 화면 내용은 보지 않아.</string>

  <!-- 5. 권한 -->
  <string name="onboarding_perm_granted">허용됐어</string>
  <string name="onboarding_perm_open_settings">동의하고 설정으로 이동</string>
  <string name="onboarding_perm_allow">동의하고 허용하기</string>
  <string name="onboarding_perm_not_now">지금은 안 할래</string>
  <string name="onboarding_perm_usage_title">사용 기록 접근을 켤까?</string>
  <string name="onboarding_perm_usage_what">어떤 앱이 언제 열리고 닫혔는지(앱 이름과 시각만). 다른 앱 사용 기록이라 민감한 정보야.</string>
  <string name="onboarding_perm_usage_why">숏폼을 본 시간, 어디서 넘어왔는지, 언제 많이 보는지 세려고. 이 기록은 이 폰 안에만 저장돼.</string>
  <string name="onboarding_perm_usage_not">화면 글자·영상 제목은 읽지 않아. 기록을 밖으로 보내지 않아. 다른 앱을 조작하지 않아.</string>
  <string name="onboarding_perm_usage_denied">나중에 설정 › 감지에서 언제든 켤 수 있어.</string>
  <string name="onboarding_perm_usage_steps">설정에서 이 앱을 찾아 \'사용 기록 접근 허용\'을 켜고 돌아오면 돼.</string>
  <string name="onboarding_perm_noti_title">알림을 보내도 될까?</string>
  <string name="onboarding_perm_noti_what">AI 친구가 보내는 메신저형 알림, 내가 정한 예약 알림, 친구가 맡긴 잔소리.</string>
  <string name="onboarding_perm_noti_why">숏폼을 오래 볼 때 말 걸고, 위험 시간대 10분 전에 미리 알려 주려고.</string>
  <string name="onboarding_perm_noti_not">짧은 간격으로 연달아 보내지 않아. 광고 알림은 없어.</string>
  <string name="onboarding_perm_noti_denied">켜지 않으면 화면 위 캐릭터 카드로만 말 걸어.</string>
  <string name="onboarding_perm_overlay_title">다른 앱 위에 캐릭터를 띄울까?</string>
  <string name="onboarding_perm_overlay_what">숏폼을 볼 때만 화면 가장자리에 작은 캐릭터와 카드를 띄워.</string>
  <string name="onboarding_perm_overlay_why">앱을 나가지 않고도 지금 몇 분째인지 보고, 한 번에 멈출 수 있게.</string>
  <string name="onboarding_perm_overlay_not">아래 앱 화면을 가리거나 누르지 않아. 숏폼이 아닐 때는 안 떠.</string>
  <string name="onboarding_perm_overlay_denied">켜지 않으면 같은 내용을 알림으로 보내.</string>

  <!-- 6. AI 동의 -->
  <string name="onboarding_ai_title">AI 친구를 어떻게 쓸까?</string>
  <string name="onboarding_ai_body">AI는 코드가 센 숫자를 보고 가설과 말만 써. 숫자를 지어내지 않게 검증을 거친 문장만 보여 줘.</string>
  <string name="onboarding_ai_cloud">클라우드 AI</string>
  <string name="onboarding_ai_cloud_desc">가장 똑똑해. 아래 항목이 Google 서버로 가.</string>
  <string name="onboarding_ai_device">기기 안 AI</string>
  <string name="onboarding_ai_device_desc">지원하는 폰에서만. 밖으로 보내지 않지만 짧은 질문만 돼.</string>
  <string name="onboarding_ai_off">쓰지 않기</string>
  <string name="onboarding_ai_off_desc">규칙으로 만든 문장만 써. 나중에 설정에서 바꿀 수 있어.</string>
  <string name="onboarding_ai_sent_title">클라우드로 보내는 것</string>
  <string name="onboarding_ai_sent_body">코드가 계산한 주간 요약(맥락별 분, 감소율, 기록률, 위험 시간대, 앱 종류), 연령대·신분·관심사·목표·말투, 채팅 중 내가 쓴 문장(전화번호·이메일은 가림).</string>
  <string name="onboarding_ai_not_sent_title">보내지 않는 것</string>
  <string name="onboarding_ai_not_sent_body">닉네임, 원시 사용 기록, 설치 앱 목록, 연락처, 정확한 위치, 친구 이름.</string>
  <string name="onboarding_ai_transfer">국외 이전 안내: 입력은 Google LLC(미국)의 서버로 전송돼 AI 응답을 만드는 데 쓰여. 무료 등급에서는 Google이 서비스 개선에 쓸 수 있고 사람 검토자가 볼 수 있어. 그래서 집계 숫자와 범주만 보내. 언제든 설정 › AI에서 끌 수 있어.</string>
  <string name="onboarding_ai_confirm">이렇게 할게</string>

  <!-- 6. 배터리 -->
  <string name="onboarding_battery_title">감지가 꺼지지 않게</string>
  <string name="onboarding_battery_body">일부 폰(특히 삼성)은 절전 때문에 백그라운드 앱을 멈춰. 설정에서 이 앱을 \'제한 없음\'이나 \'최적화하지 않음\'으로 바꾸면 감지가 덜 끊겨.</string>
  <string name="onboarding_battery_open">절전 설정 열기</string>

