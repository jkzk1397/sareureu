  <!-- 1. 연령 확인 (ADR-0009) -->
  <string name="onboarding_age_title">먼저 나이대를 알려 줘</string>
  <string name="onboarding_age_body">만 18세 이상만 쓸 수 있어. 생년월일은 묻지 않아. 이 답은 또래 비교와 말투에만 써.</string>
  <string name="onboarding_age_18_24">만 18~24세</string>
  <string name="onboarding_age_25_29">만 25~29세</string>
  <string name="onboarding_age_30_39">만 30~39세</string>
  <string name="onboarding_age_40_plus">만 40세 이상</string>
  <string name="onboarding_age_under_18">만 18세 미만</string>
  <string name="onboarding_underage_title">지금은 함께할 수 없어</string>
  <string name="onboarding_underage_body">이 앱은 AI 서비스 약관에 따라 만 18세 이상만 쓸 수 있어. 고른 나이는 저장하지 않았어.\n\n숏폼이나 스마트폰 사용이 고민이라면 스마트쉼센터(국번 없이 1599-0075, iapc.or.kr)에서 무료로 상담받을 수 있어.</string>
  <string name="onboarding_underage_close">닫기</string>

  <!-- 1. 약관·개인정보 처리 안내 -->
  <string name="onboarding_terms_title">무엇이 어디에 남는지 먼저 볼래?</string>
  <string name="onboarding_terms_device_title">이 폰 안에만 남는 것</string>
  <string name="onboarding_terms_device_body">앱을 연 시각과 순서(사용 기록), 숏폼 세션, 알림에 대한 내 답, 채팅, 프로필. 세션은 90일, 원시 기록은 7일 뒤 지워져.</string>
  <string name="onboarding_terms_cloud_title">동의하면 밖으로 나가는 것</string>
  <string name="onboarding_terms_cloud_body">AI를 켜면: 코드가 계산한 요약(맥락별 시간, 감소율 등)과 연령대·신분·관심사. 친구 기능을 켜면: 하루 감소율과 기록률만.</string>
  <string name="onboarding_terms_never_title">절대 하지 않는 것</string>
  <string name="onboarding_terms_never_body">화면 글자·영상 제목·메시지를 저장하지 않아. 다른 앱을 대신 누르거나 닫지 않아. 설치 앱 목록·연락처·위치를 보내지 않아.</string>
  <string name="onboarding_terms_control">설정 › 개인정보에서 언제든 내보내고 모두 지울 수 있어.</string>
  <string name="onboarding_terms_accept">알겠어, 시작할게</string>

  <!-- 2. 프로필 -->
  <string name="onboarding_profile_title">뭐라고 부를까?</string>
  <string name="onboarding_profile_body">별명이면 충분해. 실명은 필요 없어.</string>
  <string name="onboarding_nickname_label">닉네임</string>
  <string name="onboarding_nickname_default">친구</string>
  <string name="onboarding_occupation_title">요즘 주로 뭐 해?</string>
  <string name="onboarding_occupation_hint">하루 리듬 기본값과 또래 비교에 써.</string>
  <string name="onboarding_occ_university">대학생</string>
  <string name="onboarding_occ_grad">대학원생·취준생</string>
  <string name="onboarding_occ_office">직장인</string>
  <string name="onboarding_occ_shift">교대·프리랜서</string>
  <string name="onboarding_occ_other">기타</string>

  <!-- 3. 하루 리듬 -->
  <string name="onboarding_rhythm_title">하루 리듬을 알려 줘</string>
  <string name="onboarding_rhythm_body">숏폼을 본 때가 출근길인지, 밥 먹을 때인지, 자기 전인지 나눠 볼게. 모르면 비워 둬도 돼.</string>

  <!-- 4. 목표·관심사·말투 -->
  <string name="onboarding_goals_title">뭘 바꾸고 싶어?</string>
  <string name="onboarding_goals_hint">여러 개 골라도 돼. 리포트에서 이 목표를 먼저 봐.</string>
  <string name="onboarding_goal_sleep">잠 잘 자기</string>
  <string name="onboarding_goal_focus">집중하기</string>
  <string name="onboarding_goal_time_back">시간 되찾기</string>
  <string name="onboarding_goal_mood">기분 챙기기</string>
  <string name="onboarding_goal_other">그냥 궁금해서</string>
  <string name="onboarding_interests_title">숏폼 대신 하고 싶은 것</string>
  <string name="onboarding_interests_hint">전략을 내 말로 바꿀 때 써.</string>
  <string-array name="onboarding_interest_choices">
    <item>운동</item>
