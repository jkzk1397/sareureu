  <string name="friends_row_a11y">%1$s, 연속 %2$d일</string>
  <string name="friends_row_watching_a11y">%1$s, 지금 숏폼 보는 중, 연속 %2$d일</string>
  <string name="friends_poke_button_a11y">%1$s에게 잔소리 보내기</string>
